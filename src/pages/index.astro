---
import Layout from '../layouts/Layout.astro';

const roles = ['Regulatory Strategy', 'Regulatory CMC', 'Regulatory Operations', 'Labeling', 'Advertising & Promotion', 'Regulatory Intelligence', 'Submission Management', 'Quality / Regulatory'];
const steps = [
  { no:'01', title:'Define the mandate', body:'We map the product, phase, regulatory event, team dynamics and decisions this person must own.' },
  { no:'02', title:'Calibrate the evidence', body:'Experience is tested against real FDA-facing work—not keywords, titles or company pedigree alone.' },
  { no:'03', title:'Search the specialist market', body:'A focused outreach strategy reaches proven regulatory talent, including professionals not actively applying.' },
  { no:'04', title:'Present with context', body:'Every candidate arrives with a concise rationale: relevant evidence, likely strengths and points to explore.' }
];
const schema = {'@context':'https://schema.org','@type':'EmploymentAgency',name:'Rexpert',url:'https://rexpert.com',description:'FDA-informed Regulatory Affairs recruiting for US drug development.',areaServed:'United States'};
---
<Layout title="Rexpert — FDA-informed Regulatory Affairs recruiting" description="Permanent and contract Regulatory Affairs talent for US drug development, evaluated through an FDA-informed lens.">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <div class="signal-bar"><span>US DRUG DEVELOPMENT</span><span>PERMANENT + CONTRACT</span><span>FOUNDER-LED SEARCH</span></div>
  <header class="site-header">
    <a class="brand" href="#top" aria-label="Rexpert home"><svg viewBox="0 0 42 42" aria-hidden="true"><path d="M5 5h15c9 0 14 4 14 12 0 5-3 9-8 11l10 10H24L14 27v11H5V5Zm9 8v8h6c3 0 5-1 5-4 0-3-2-4-5-4h-6Z"/></svg><span>rexpert<small>REGULATORY SEARCH</small></span></a>
    <nav aria-label="Primary navigation" data-nav><a href="#employers">For employers</a><a href="#candidates">For candidates</a><a href="#expertise">Expertise</a><a href="#method">Method</a></nav>
    <a class="header-cta" href="#contact">Brief a search <span>↗</span></a>
    <button class="menu-button" type="button" aria-label="Open menu" aria-expanded="false" data-menu><i></i><i></i></button>
  </header>

  <main id="top">
    <section class="hero">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="overline">Regulatory Affairs recruitment · United States</p>
          <h1>Recruit regulatory talent with the <em>right evidence.</em></h1>
          <p class="lede">Permanent and contract professionals for drug development—identified by a search partner who understands the work behind an FDA milestone.</p>
          <div class="hero-actions"><a class="button coral" href="#contact">Find regulatory talent <span>↗</span></a><a class="button ghost" href="#candidates">Explore your next move <span>→</span></a></div>
        </div>
        <div class="dossier" aria-label="Candidate evidence dossier visualization">
          <div class="dossier-top"><span>SEARCH DOSSIER</span><span>RX–001</span></div>
          <div class="stamp">FDA<br/><small>INFORMED</small></div>
          <div class="dossier-role"><small>MANDATE</small><strong>Director,<br/>Regulatory CMC</strong></div>
          <dl><div><dt>PRODUCT</dt><dd>Biologic</dd></div><div><dt>INFLECTION</dt><dd>Pre-BLA</dd></div><div><dt>OWNERSHIP</dt><dd>Strategy + execution</dd></div><div><dt>EVIDENCE</dt><dd>Agency-facing</dd></div></dl>
          <div class="dossier-line"><i></i><i></i><i></i><i></i></div>
          <p>Title matched <s>✓</s><br/>Mandate matched <b>✓</b></p>
        </div>
      </div>
      <div class="hero-proof"><p>Focused on the functions that determine how medicines move forward.</p><div><span>Pharma</span><span>Biotech</span><span>CRO / CDMO</span><span>Regulatory consulting</span></div></div>
    </section>

    <section class="choice" id="employers">
      <p class="section-no">01 / CHOOSE YOUR PATH</p>
      <div class="choice-intro"><p class="overline">One specialist market. Two perspectives.</p><h2>Built for the people hiring—and the people doing the work.</h2></div>
      <div class="choice-panels">
        <article class="employer-panel"><span class="panel-label">FOR EMPLOYERS</span><h3>Your program cannot afford a surface-level match.</h3><p>We translate a business need into a precise regulatory mandate, then search for professionals whose experience stands up to the work ahead.</p><ul><li>Permanent and retained search</li><li>Contract and interim talent</li><li>Single or multi-hire programs</li><li>Specialist through executive</li></ul><a href="#contact">Discuss a hiring need <span>↗</span></a></article>
        <article class="candidate-panel" id="candidates"><span class="panel-label">FOR CANDIDATES</span><h3>Your experience deserves a more informed conversation.</h3><p>We look beyond your latest title to understand the products, submissions, decisions and agency interactions that define your value.</p><ul><li>Confidential career conversations</li><li>Permanent and contract opportunities</li><li>Role context before introduction</li><li>Direct, specialist feedback</li></ul><a href="mailto:hello@rexpert.com?subject=Candidate%20introduction">Introduce yourself <span>↗</span></a></article>
      </div>
    </section>

    <section class="why">
      <div class="why-title"><p class="section-no light">02 / THE REXPERT DIFFERENCE</p><p class="overline">Recruitment, interpreted through regulatory work</p><h2>The shortlist should make sense to your regulatory lead—not just HR.</h2></div>
      <div class="why-evidence">
        <article><span>01</span><h3>FDA-informed founder</h3><p>The search lens comes from consulting in the US drug regulatory environment, shaping better questions from the first briefing.</p></article>
        <article><span>02</span><h3>Mandate before market</h3><p>We identify the product, phase, submission and ownership required before approaching candidates.</p></article>
        <article><span>03</span><h3>Context in every introduction</h3><p>Shortlists explain why the evidence fits—and where a deeper interview should probe.</p></article>
      </div>
    </section>

    <section class="expertise" id="expertise">
      <p class="section-no">03 / SPECIALIST COVERAGE</p>
      <div class="expertise-head"><div><p class="overline">Roles across the regulatory function</p><h2>From strategy to submission. From build to lifecycle.</h2></div><p>We focus on US drug Regulatory Affairs while recognizing the adjacent capabilities every high-performing function depends on.</p></div>
      <div class="role-index">{roles.map((role,i)=><div><span>{String(i+1).padStart(2,'0')}</span><strong>{role}</strong><i>↗</i></div>)}</div>
      <div class="seniority"><span>ASSOCIATE</span><i></i><span>MANAGER</span><i></i><span>DIRECTOR</span><i></i><span>VP / HEAD OF</span></div>
    </section>

    <section class="method" id="method">
      <div class="method-head"><p class="section-no light">04 / HOW SEARCH WORKS</p><p class="overline">A consultative process, made visible</p><h2>Less noise.<br/>More signal.</h2><p>Speed matters. Precision matters more. Our four-stage method keeps both in view.</p></div>
      <div class="method-steps">{steps.map(step=><article><span>{step.no}</span><div><h3>{step.title}</h3><p>{step.body}</p></div></article>)}</div>
    </section>

    <section class="statement">
      <div class="statement-mark"><svg viewBox="0 0 42 42" aria-hidden="true"><path d="M5 5h15c9 0 14 4 14 12 0 5-3 9-8 11l10 10H24L14 27v11H5V5Zm9 8v8h6c3 0 5-1 5-4 0-3-2-4-5-4h-6Z"/></svg></div>
      <blockquote>“The strongest regulatory hire is not the résumé with the most keywords. It is the person whose evidence matches the next decision.”</blockquote>
      <p>THE REXPERT SEARCH PRINCIPLE</p>
    </section>

    <section class="contact" id="contact">
      <div><p class="section-no">05 / START A CONVERSATION</p><p class="overline">A better search starts with a sharper brief</p><h2>Tell us what needs to move forward.</h2><p>Share the role, regulatory milestone or capability gap. We’ll help define the mandate and the market.</p></div>
      <form action="mailto:hello@rexpert.com" method="post" enctype="text/plain">
        <label>Your name<input name="name" autocomplete="name" required placeholder="Jane Smith"/></label>
        <label>Work email<input name="email" type="email" autocomplete="email" required placeholder="jane@company.com"/></label>
        <label>What do you need?<select name="need" required><option value="">Select one</option><option>Permanent hire</option><option>Contract talent</option><option>Confidential career conversation</option><option>Not sure yet</option></select></label>
        <button type="submit">Start the conversation <span>↗</span></button>
        <small>This demonstration opens your email client. No information is stored by this website.</small>
      </form>
    </section>
  </main>
  <footer><a class="brand footer-brand" href="#top"><svg viewBox="0 0 42 42" aria-hidden="true"><path d="M5 5h15c9 0 14 4 14 12 0 5-3 9-8 11l10 10H24L14 27v11H5V5Zm9 8v8h6c3 0 5-1 5-4 0-3-2-4-5-4h-6Z"/></svg><span>rexpert<small>REGULATORY SEARCH</small></span></a><p>FDA-informed Regulatory Affairs recruiting for US drug development.</p><div><a href="#employers">Employers</a><a href="#candidates">Candidates</a><a href="#expertise">Expertise</a><a href="#contact">Contact</a></div><small>© {new Date().getFullYear()} Rexpert. Demonstration concept.</small></footer>
  <script>
    const menu=document.querySelector('[data-menu]');const nav=document.querySelector('[data-nav]');
    const close=()=>{menu?.setAttribute('aria-expanded','false');menu?.setAttribute('aria-label','Open menu');nav?.classList.remove('open');document.body.classList.remove('menu-open')};
    menu?.addEventListener('click',()=>{const isOpen=menu.getAttribute('aria-expanded')==='true';if(isOpen){close()}else{menu.setAttribute('aria-expanded','true');menu.setAttribute('aria-label','Close menu');nav?.classList.add('open');document.body.classList.add('menu-open')}});
    nav?.querySelectorAll('a').forEach(a=>a.addEventListener('click',close));document.addEventListener('keydown',e=>{if(e.key==='Escape')close()});
    const observer=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)e.target.classList.add('visible')}),{threshold:.1});document.querySelectorAll('section:not(.hero)').forEach(s=>{s.classList.add('reveal');observer.observe(s)});
  </script>
</Layout>
