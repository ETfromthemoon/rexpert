---
import Layout from '../layouts/Layout.astro';

const roles = ['Regulatory Strategy', 'CMC Regulatory', 'Regulatory Operations', 'Labeling', 'Advertising & Promotion', 'Global Submissions'];
const schema = {
  '@context': 'https://schema.org', '@type': 'EmploymentAgency', name: 'Rexpert',
  url: 'https://rexpert.com', description: 'Specialist recruiting for Regulatory Affairs professionals in drug development.',
  areaServed: 'United States', knowsAbout: ['FDA regulatory affairs', 'Drug development', 'Regulatory recruiting']
};
---
<Layout title="Rexpert — Regulatory talent, seen through an FDA lens" description="Specialist contract and permanent recruiting for Regulatory Affairs professionals in US drug development.">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <header class="site-header" data-header>
    <a class="brand" href="#top" aria-label="Rexpert home">
      <svg viewBox="0 0 38 38" aria-hidden="true"><path d="M4 4h13c8 0 12 4 12 10 0 5-2 8-7 10l9 10H20l-8-10v10H4V4Zm8 7v7h5c3 0 4-1 4-4 0-2-1-3-4-3h-5Z"/></svg>
      <span>rexpert</span>
    </a>
    <nav aria-label="Primary navigation" data-nav>
      <a href="#approach">Approach</a><a href="#expertise">Expertise</a><a href="#founder">Why Rexpert</a>
      <a class="nav-cta" href="#contact">Start a search <span>↗</span></a>
    </nav>
    <button class="menu-button" type="button" aria-label="Open menu" aria-expanded="false" data-menu><span></span><span></span></button>
  </header>

  <main id="top">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> Regulatory Affairs recruiting · United States</p>
        <h1>The right regulatory hire can change the <em>trajectory.</em></h1>
        <p class="hero-lede">Contract and permanent talent for drug development—evaluated by a recruiter who understands what the FDA will ask next.</p>
        <div class="hero-actions"><a class="button primary" href="#contact">Book a talent briefing <span>↗</span></a><a class="text-link" href="#approach">See our approach <span>↓</span></a></div>
      </div>
      <div class="hero-visual" aria-label="Regulatory milestones connected to the right specialist">
        <div class="radar">
          <span class="orbit orbit-a"></span><span class="orbit orbit-b"></span><span class="orbit orbit-c"></span>
          <div class="radar-center"><small>THE FIT</small><strong>Expertise<br/>at the inflection<br/>point.</strong></div>
          <span class="signal s1"><i></i> IND</span><span class="signal s2"><i></i> NDA</span><span class="signal s3"><i></i> CMC</span><span class="signal s4"><i></i> FDA</span>
        </div>
        <p class="visual-note">01 / SEARCH CALIBRATION</p>
      </div>
      <div class="hero-foot"><span>Built for biotech, pharma &amp; regulatory consultancies</span><span>Permanent <i>+</i> Contract</span><span>From specialist to executive</span></div>
    </section>

    <section class="tension" id="approach">
      <div class="section-index">01 <span>/</span> The difference</div>
      <div class="tension-copy">
        <p class="kicker">Recruiting is not enough.</p>
        <h2>You need someone who understands the work behind the title.</h2>
        <p>Regulatory hiring breaks down when a résumé is matched to a job description instead of a development program. We start with the regulatory event, the product and the risk—then find the person equipped to move it forward.</p>
      </div>
      <div class="difference-list">
        <article><span>01</span><div><h3>Milestone first</h3><p>We calibrate around the submission, meeting, remediation or build ahead—not a generic list of keywords.</p></div></article>
        <article><span>02</span><div><h3>Practitioner judgment</h3><p>Search led with the perspective of an FDA drug consultant who can pressure-test depth, context and fit.</p></div></article>
        <article><span>03</span><div><h3>One specialist network</h3><p>Focused relationships across US drug regulatory affairs, from hands-on operators to strategic leaders.</p></div></article>
      </div>
    </section>

    <section class="pathway" id="expertise">
      <div class="section-index light">02 <span>/</span> Where we work</div>
      <div class="pathway-heading"><p class="kicker">Across the drug development pathway</p><h2>Talent aligned to the moment that matters.</h2></div>
      <div class="pathway-map">
        <div class="line"></div>
        <article><b>01</b><span></span><small>EARLY DEVELOPMENT</small><h3>Shape the path</h3><p>Regulatory strategy · Pre-IND · IND authoring</p></article>
        <article><b>02</b><span></span><small>CLINICAL DEVELOPMENT</small><h3>Keep momentum</h3><p>Agency interactions · CMC · Operations</p></article>
        <article><b>03</b><span></span><small>MARKET ENTRY</small><h3>Make the case</h3><p>NDA / BLA · Labeling · Submission leadership</p></article>
        <article><b>04</b><span></span><small>LIFECYCLE</small><h3>Protect value</h3><p>Post-approval · Ad/Promo · Change management</p></article>
      </div>
      <div class="role-ticker" aria-label="Areas of expertise">{roles.map(role => <span>{role}<i>↗</i></span>)}</div>
    </section>

    <section class="model">
      <div class="section-index">03 <span>/</span> Two ways to engage</div>
      <div class="model-intro"><p class="kicker">Built around your timeline</p><h2>A core hire or critical coverage.</h2></div>
      <div class="model-options">
        <article><div class="model-no">A</div><div><p class="tag">PERMANENT SEARCH</p><h3>Build the regulatory function that lasts.</h3><p>Targeted search for specialists and leaders with the exact product, stage and agency experience your program requires.</p><ul><li>Specialist through executive</li><li>Confidential and retained options</li><li>Technical search calibration</li></ul></div><a href="#contact" aria-label="Discuss a permanent search">↗</a></article>
        <article><div class="model-no">B</div><div><p class="tag">CONTRACT TALENT</p><h3>Add expertise exactly when it is needed.</h3><p>Experienced regulatory professionals for submissions, coverage gaps, surge capacity and defined program milestones.</p><ul><li>Project and interim support</li><li>Flexible engagement length</li><li>Fast, context-led shortlists</li></ul></div><a href="#contact" aria-label="Discuss contract talent">↗</a></article>
      </div>
    </section>

    <section class="founder" id="founder">
      <div class="founder-mark" aria-hidden="true"><span>R</span><div class="crosshair"></div></div>
      <div class="founder-copy">
        <div class="section-index light">04 <span>/</span> Founder-led perspective</div>
        <p class="kicker">The uncommon advantage</p>
        <h2>Regulatory judgment belongs in regulatory recruiting.</h2>
        <p class="large">Rexpert was founded by a consultant to the US FDA drug ecosystem—not a generalist recruiter learning the terminology.</p>
        <p>That perspective changes the questions we ask, the experience we recognize and the candidates we put in front of you. It means fewer mismatched conversations and a shortlist built around what your program actually needs.</p>
        <div class="principle"><span>OUR PRINCIPLE</span><strong>Understand the mandate.<br/>Then search the market.</strong></div>
      </div>
    </section>

    <section class="contact" id="contact">
      <p class="eyebrow"><span></span> Start with the regulatory need</p>
      <h2>What does your program need to move forward?</h2>
      <p>Tell us the milestone, the gap or the role. We’ll bring the regulatory perspective.</p>
      <a class="button dark" href="mailto:hello@rexpert.com?subject=Talent%20briefing">hello@rexpert.com <span>↗</span></a>
      <div class="contact-meta"><span>Contract talent</span><span>Permanent search</span><span>United States</span></div>
    </section>
  </main>
  <footer><a class="brand footer-brand" href="#top"><svg viewBox="0 0 38 38" aria-hidden="true"><path d="M4 4h13c8 0 12 4 12 10 0 5-2 8-7 10l9 10H20l-8-10v10H4V4Zm8 7v7h5c3 0 4-1 4-4 0-2-1-3-4-3h-5Z"/></svg><span>rexpert</span></a><p>Regulatory Affairs recruiting,<br/>through an FDA lens.</p><div><a href="#approach">Approach</a><a href="#expertise">Expertise</a><a href="mailto:hello@rexpert.com">Contact</a></div><small>© {new Date().getFullYear()} Rexpert. Demo concept.</small></footer>
  <script>
    const button = document.querySelector('[data-menu]'); const nav = document.querySelector('[data-nav]');
    button?.addEventListener('click', () => { const open = button.getAttribute('aria-expanded') === 'true'; button.setAttribute('aria-expanded', String(!open)); button.setAttribute('aria-label', open ? 'Open menu' : 'Close menu'); nav?.classList.toggle('open'); document.body.classList.toggle('menu-open'); });
    nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { button?.setAttribute('aria-expanded','false'); nav.classList.remove('open'); document.body.classList.remove('menu-open'); }));
    const observer = new IntersectionObserver(entries => entries.forEach(entry => { if(entry.isIntersecting) entry.target.classList.add('revealed'); }), {threshold:.12});
    document.querySelectorAll('section:not(.hero)').forEach(section => { section.classList.add('reveal'); observer.observe(section); });
  </script>
</Layout>
