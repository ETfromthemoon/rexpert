---
import Layout from '../layouts/Layout.astro';

const roles = ['Regulatory Strategy', 'Regulatory CMC', 'Regulatory Operations', 'Labeling', 'Advertising & Promotion', 'Regulatory Intelligence', 'Submission Management', 'Quality / Regulatory'];
const steps = [
  { no:'01', title:'Define the mandate', body:'We map the product, phase, regulatory event, team dynamics and decisions this person must own.' },
  { no:'02', title:'Calibrate the evidence', body:'Experience is tested against real FDA-facing work—not keywords, titles or company pedigree alone.' },
  { no:'03', title:'Search the specialist market', body:'A focused outreach strategy reaches proven regulatory talent, including professionals not actively applying.' },
  { no:'04', title:'Present with context', body:'Every candidate arrives with a concise rationale: relevant evidence, likely strengths and points to explore.' }
];
const competitors = [
  { name:'Halloran Consulting Group', region:'US · Boston / San Diego', url:'https://hallorancg.com', signal:'Regulatory readiness, FDA meeting strategy and a deep biotech bench.' },
  { name:'Biologics Consulting Group', region:'US · Alexandria, VA', url:'https://www.biologicsconsulting.com', signal:'Multidisciplinary support across biologics, pharma, devices, combination products and CGT.' },
  { name:'ELIQUENT Life Sciences', region:'Global · Greenleaf successor', url:'https://eliquent.com', signal:'A combined regulatory brand bringing together Greenleaf Health, Validant, DataRevive, Oriel Stat-a-Matrix and IDEC.' },
  { name:'Lachman Consultants', region:'US · FDA / generics specialist', url:'https://www.lachmanconsultants.com', signal:'Longstanding generic-drug, CMC and FDA compliance expertise.' },
  { name:'PharmaLex', region:'Germany · Global', url:'https://www.pharmalex.com', signal:'Broad regulatory affairs, CMC and pharmacovigilance outsourcing across markets.' },
  { name:'Cato Research / Cato BioVentures', region:'US · Boutique development', url:'https://www.allucent.com', signal:'Regulatory and clinical development strategy for smaller and mid-sized biotechs.' },
  { name:'Voisin Consulting Life Sciences', region:'France · Global bridge', url:'https://voisinconsulting.com', signal:'Regulatory and market-access strategy connecting EU, US and other global pathways.' }
];
const adjacent = { name:'Hyman, Phelps & McNamara', region:'US · Washington, DC', url:'https://hpm.com', signal:'FDA regulatory law firm — adjacent to the consultancy set, but present in the same sponsor conversations.' };
const intelTools = [
  { no:'01', title:'Discussion groups + blogs', lens:'Live practitioner discourse', tools:[['Fierce Biotech','https://www.fiercebiotech.com'],['Fierce Pharma','https://www.fiercepharma.com'],['Drug & Device Law','https://www.druganddevicelawblog.com'],['CafePharma','https://www.cafepharma.com'],['Eye on FDA','https://www.eyeonfda.com'],['FDA Law Blog','https://www.fdalawblog.net']] },
  { no:'02', title:'Professional associations', lens:'Credentialed community signal', tools:[['AAPS','https://www.aaps.org'],['ACRP','https://acrpnet.org'],['DIA','https://www.diaglobal.org'],['RAPS','https://www.raps.org'],['TOPRA','https://www.topra.org'],['CAPRA','https://www.capra.ca']] },
  { no:'03', title:'Publication providers', lens:'Structured regulatory coverage', tools:[['Elsevier Business Intelligence','https://www.elsevier.com'],['FDA News','https://www.fdanews.com'],['Informa Healthcare','https://www.pjbpubs.com'],['SCRIP World Pharmaceutical News','https://www.pjbpubs.com']] },
  { no:'04', title:'Alerts + newsletters', lens:'Changes worth acting on', tools:[['Regulatory Focus','https://www.raps.org/news-and-articles'],['FDA subscriptions','https://www.fda.gov/about-fda/contact-fda/subscribe'],['Inside Health Policy','https://www.insidehealthpolicy.com'],['Nature','https://www.nature.com'],['Applied Clinical Trials','https://www.appliedclinicaltrialsonline.com'],['BioWorld Today','https://www.bioworld.com']] },
  { no:'05', title:'Business intelligence', lens:'Company and pipeline context', tools:[['BioSpace','https://www.biospace.com'],['CenterWatch','https://www.centerwatch.com'],['PharmaLicensing','https://www.pharmalicensing.com'],['DataMonitor','https://www.datamonitor.com'],['Pipeline Review','https://www.pipelinereview.com']] },
  { no:'06', title:'Paid intelligence databases', lens:'Deep competitive evidence', tools:[['Adis R&D Insight','https://www.wolterskluwer.com'],['BioPharm Insight','https://www.biopharminsight.com'],['MedTRACK','https://www.medtrack.com'],['Pharmaprojects','https://www.pharmaprojects.com'],['Thomson Pharma Partnering','https://www.thomsonreuters.com']] }
];
const schema = {'@context':'https://schema.org','@type':'EmploymentAgency',name:'Rexpert',url:'https://rexpert.com',description:'FDA-informed Regulatory Affairs recruiting for US drug development.',areaServed:'United States'};
const asset = (path:string) => `${import.meta.env.BASE_URL}${path}`;
---
<Layout title="Rexpert — FDA-informed Regulatory Affairs recruiting" description="Permanent and contract Regulatory Affairs talent for US drug development, evaluated through an FDA-informed lens.">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <div class="scroll-progress" aria-hidden="true"><i data-progress></i></div>
  <div class="signal-bar"><span>US DRUG DEVELOPMENT</span><span>PERMANENT + CONTRACT</span><span>FOUNDER-LED SEARCH</span></div>
  <header class="site-header">
    <a class="brand" href="#top" aria-label="Rexpert home"><svg viewBox="0 0 42 42" aria-hidden="true"><path d="M5 5h15c9 0 14 4 14 12 0 5-3 9-8 11l10 10H24L14 27v11H5V5Zm9 8v8h6c3 0 5-1 5-4 0-3-2-4-5-4h-6Z"/></svg><span>rexpert<small>REGULATORY SEARCH</small></span></a>
    <nav aria-label="Primary navigation" data-nav><a href="#employers">For employers</a><a href="#candidates">For candidates</a><a href="#expertise">Expertise</a><a href="#market">Market map</a><a href="#intelligence">Intelligence</a><a href="#method">Method</a></nav>
    <a class="header-cta" href="#contact">Brief a search <span>↗</span></a>
    <button class="menu-button" type="button" aria-label="Open menu" aria-expanded="false" data-menu><i></i><i></i></button>
  </header>

  <main id="top">
    <section class="hero">
      <div class="hero-grid">
        <div class="hero-copy" data-hero-copy>
          <p class="overline">Regulatory Affairs recruitment · United States</p>
          <h1>Recruit regulatory talent with the <em>right evidence.</em></h1>
          <p class="lede">Permanent and contract professionals for drug development—identified by a search partner who understands the work behind an FDA milestone.</p>
          <div class="hero-actions"><a class="button coral" href="#contact">Find regulatory talent <span>↗</span></a><a class="button ghost" href="#candidates">Explore your next move <span>→</span></a></div>
        </div>
        <div class="dossier" data-dossier aria-label="Candidate evidence dossier visualization">
          <div class="dossier-top"><span>SEARCH DOSSIER</span><span>RX–001</span></div>
          <div class="stamp">FDA<br/><small>INFORMED</small></div>
          <div class="dossier-role"><small>MANDATE</small><strong>Director,<br/>Regulatory CMC</strong></div>
          <dl><div><dt>PRODUCT</dt><dd>Biologic</dd></div><div><dt>INFLECTION</dt><dd>Pre-BLA</dd></div><div><dt>OWNERSHIP</dt><dd>Strategy + execution</dd></div><div><dt>EVIDENCE</dt><dd>Agency-facing</dd></div></dl>
          <div class="dossier-line"><i></i><i></i><i></i><i></i></div>
          <p>Title matched <s>✓</s><br/>Mandate matched <b>✓</b></p>
        </div>
      </div>
      <div class="hero-proof"><p>Focused on the functions that determine how medicines move forward.</p><div><span>Pharma</span><span>Biotech</span><span>CRO / CDMO</span><span>Regulatory consulting</span></div></div>
      <figure class="hero-photo"><img data-hero-photo src={asset('images/lab-team.jpg')} width="1800" height="1050" alt="Microscopic view of cells used in life sciences research" loading="eager"/><figcaption><span>THE ENVIRONMENT</span> Where science, evidence and regulatory decisions meet.</figcaption></figure>
    </section>

    <section class="choice" id="employers">
      <p class="section-no">01 / CHOOSE YOUR PATH</p>
      <div class="choice-intro"><p class="overline">One specialist market. Two perspectives.</p><h2>Built for the people hiring—and the people doing the work.</h2></div>
      <div class="choice-panels">
        <article class="employer-panel"><figure><img src={asset('images/leadership-meeting.jpg')} width="1600" height="900" alt="Business leaders reviewing a hiring mandate together" loading="lazy"/></figure><span class="panel-label">FOR EMPLOYERS</span><h3>Your program cannot afford a surface-level match.</h3><p>We translate a business need into a precise regulatory mandate, then search for professionals whose experience stands up to the work ahead.</p><ul><li>Permanent and retained search</li><li>Contract and interim talent</li><li>Single or multi-hire programs</li><li>Specialist through executive</li></ul><a href="#contact">Discuss a hiring need <span>↗</span></a></article>
        <article class="candidate-panel" id="candidates"><figure><img src={asset('images/candidate-team.jpg')} width="1800" height="1050" alt="A diverse professional team collaborating in a modern workplace" loading="lazy"/></figure><span class="panel-label">FOR CANDIDATES</span><h3>Your experience deserves a more informed conversation.</h3><p>We look beyond your latest title to understand the products, submissions, decisions and agency interactions that define your value.</p><ul><li>Confidential career conversations</li><li>Permanent and contract opportunities</li><li>Role context before introduction</li><li>Direct, specialist feedback</li></ul><a href="mailto:hello@rexpert.com?subject=Candidate%20introduction">Introduce yourself <span>↗</span></a></article>
      </div>
    </section>

    <section class="why">
      <div class="why-title"><p class="section-no light">02 / THE REXPERT DIFFERENCE</p><figure><img src={asset('images/team-workshop.jpg')} width="1800" height="1050" alt="Specialists reviewing evidence during a collaborative workshop" loading="lazy"/></figure><p class="overline">Recruitment, interpreted through regulatory work</p><h2>The shortlist should make sense to your regulatory lead—not just HR.</h2></div>
      <div class="why-evidence">
        <article><span>01</span><h3>FDA-informed founder</h3><p>The search lens comes from consulting in the US drug regulatory environment, shaping better questions from the first briefing.</p></article>
        <article><span>02</span><h3>Mandate before market</h3><p>We identify the product, phase, submission and ownership required before approaching candidates.</p></article>
        <article><span>03</span><h3>Context in every introduction</h3><p>Shortlists explain why the evidence fits—and where a deeper interview should probe.</p></article>
      </div>
    </section>

    <section class="expertise" id="expertise">
      <p class="section-no">03 / SPECIALIST COVERAGE</p>
      <div class="expertise-head"><div><p class="overline">Roles across the regulatory function</p><h2>From strategy to submission. From build to lifecycle.</h2></div><p>We focus on US drug Regulatory Affairs while recognizing the adjacent capabilities every high-performing function depends on.</p></div>
      <div class="role-index">{roles.map((role,i)=><div><span>{String(i+1).padStart(2,'0')}</span><strong>{role}</strong><i>↗</i></div>)}</div>
      <div class="seniority"><span>ASSOCIATE</span><i></i><span>MANAGER</span><i></i><span>DIRECTOR</span><i></i><span>VP / HEAD OF</span></div>
    </section>

    <section class="market-map" id="market">
      <div class="market-map-head">
        <div><p class="section-no light">04 / THE COMPETITIVE SET</p><p class="overline">What clients compare before they call</p><h2>Strategy consultancies own the advisory conversation. Rexpert owns the talent signal.</h2></div>
        <p>These firms shape the regulatory brief, the pathway and the evidence sponsors need. The opportunity for Rexpert is distinct: translate that same FDA context into the people who can execute the next decision.</p>
      </div>
      <div class="competitor-grid">
        {competitors.map((competitor, i)=><article class="competitor-card"><div class="competitor-card-top"><span>{String(i + 1).padStart(2,'0')}</span><span>{competitor.region}</span></div><h3>{competitor.name}</h3><p>{competitor.signal}</p><a href={competitor.url} target="_blank" rel="noreferrer">View company <span>↗</span></a></article>)}
      </div>
      <aside class="adjacent-card"><div><p class="section-no light">ADJACENT TIER</p><h3>{adjacent.name}</h3><p>{adjacent.region} · {adjacent.signal}</p></div><a href={adjacent.url} target="_blank" rel="noreferrer">View firm <span>↗</span></a></aside>
    </section>

    <section class="intelligence" id="intelligence">
      <div class="intelligence-head">
        <div><p class="section-no">05 / REGULATORY INTELLIGENCE</p><p class="overline">The signal stack behind a sharper search</p><h2>Better questions start before the brief.</h2></div>
        <p>The supplied reference maps the places regulatory leaders track: practitioner conversation, professional communities, publication feeds, business intelligence and paid databases. Rexpert turns those signals into better talent conversations.</p>
      </div>
      <div class="intel-grid">
        {intelTools.map((tool)=><details class="intel-card"><summary><span>{tool.no}</span><strong>{tool.title}</strong><i>＋</i></summary><p>{tool.lens}</p><div class="intel-links">{tool.tools.map(([name,url])=><a href={url} target="_blank" rel="noreferrer">{name}<span>↗</span></a>)}</div></details>)}
      </div>
      <div class="intelligence-note"><span>REXPERT PRINCIPLE</span><p>Tools are not the deliverable. The advantage is knowing which signal changes the hiring mandate—and which one is just noise.</p><a class="button coral" href="#contact">Build an intelligence brief <span>↗</span></a></div>
    </section>

    <section class="method" id="method">
      <div class="method-head"><p class="section-no light">06 / HOW SEARCH WORKS</p><p class="overline">A consultative process, made visible</p><h2>Less noise.<br/>More signal.</h2><p>Speed matters. Precision matters more. Our four-stage method keeps both in view.</p></div>
      <div class="method-steps">{steps.map(step=><article><span>{step.no}</span><div><h3>{step.title}</h3><p>{step.body}</p></div></article>)}</div>
    </section>

    <section class="statement">
      <div class="statement-mark"><svg viewBox="0 0 42 42" aria-hidden="true"><path d="M5 5h15c9 0 14 4 14 12 0 5-3 9-8 11l10 10H24L14 27v11H5V5Zm9 8v8h6c3 0 5-1 5-4 0-3-2-4-5-4h-6Z"/></svg></div>
      <blockquote>“The strongest regulatory hire is not the résumé with the most keywords. It is the person whose evidence matches the next decision.”</blockquote>
      <p>THE REXPERT SEARCH PRINCIPLE</p>
    </section>

    <section class="contact" id="contact">
      <div><p class="section-no">07 / START A CONVERSATION</p><p class="overline">A better search starts with a sharper brief</p><h2>Tell us what needs to move forward.</h2><p>Share the role, regulatory milestone or capability gap. We’ll help define the mandate and the market.</p></div>
      <form action="mailto:hello@rexpert.com" method="post" enctype="text/plain">
        <label>Your name<input name="name" autocomplete="name" required placeholder="Jane Smith"/></label>
        <label>Work email<input name="email" type="email" autocomplete="email" required placeholder="jane@company.com"/></label>
        <label>What do you need?<select name="need" required><option value="">Select one</option><option>Permanent hire</option><option>Contract talent</option><option>Confidential career conversation</option><option>Not sure yet</option></select></label>
        <button type="submit">Start the conversation <span>↗</span></button>
        <small>This demonstration opens your email client. No information is stored by this website.</small>
      </form>
    </section>
  </main>
  <footer><a class="brand footer-brand" href="#top"><svg viewBox="0 0 42 42" aria-hidden="true"><path d="M5 5h15c9 0 14 4 14 12 0 5-3 9-8 11l10 10H24L14 27v11H5V5Zm9 8v8h6c3 0 5-1 5-4 0-3-2-4-5-4h-6Z"/></svg><span>rexpert<small>REGULATORY SEARCH</small></span></a><p>FDA-informed Regulatory Affairs recruiting for US drug development.</p><div><a href="#employers">Employers</a><a href="#candidates">Candidates</a><a href="#expertise">Expertise</a><a href="#market">Market map</a><a href="#contact">Contact</a></div><small>© {new Date().getFullYear()} Rexpert. Demonstration concept.</small></footer>
  <script>
    const menu=document.querySelector('[data-menu]');const nav=document.querySelector('[data-nav]');
    const close=()=>{menu?.setAttribute('aria-expanded','false');menu?.setAttribute('aria-label','Open menu');nav?.classList.remove('open');document.body.classList.remove('menu-open')};
    menu?.addEventListener('click',()=>{const isOpen=menu.getAttribute('aria-expanded')==='true';if(isOpen){close()}else{menu.setAttribute('aria-expanded','true');menu.setAttribute('aria-label','Close menu');nav?.classList.add('open');document.body.classList.add('menu-open')}});
    nav?.querySelectorAll('a').forEach(a=>a.addEventListener('click',close));document.addEventListener('keydown',e=>{if(e.key==='Escape')close()});
    const observer=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)e.target.classList.add('visible')}),{threshold:.1});document.querySelectorAll('section:not(.hero)').forEach(s=>{s.classList.add('reveal');observer.observe(s)});
    const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;const progress=document.querySelector('[data-progress]');const dossier=document.querySelector('[data-dossier]');const heroCopy=document.querySelector('[data-hero-copy]');const heroPhoto=document.querySelector('[data-hero-photo]');let ticking=false;
    const renderScroll=()=>{const y=scrollY;const max=document.documentElement.scrollHeight-innerHeight;const ratio=max>0?y/max:0;if(progress instanceof HTMLElement)progress.style.transform=`scaleX(${ratio})`;if(!reduce&&innerWidth>760){const shift=Math.min(y,1300);if(dossier instanceof HTMLElement)dossier.style.transform=`translate3d(0,${shift*.065}px,0) rotateX(${shift*.004}deg)`;if(heroCopy instanceof HTMLElement)heroCopy.style.transform=`translate3d(0,${shift*.025}px,0)`;if(heroPhoto instanceof HTMLElement)heroPhoto.style.transform=`translate3d(0,${Math.max(0,y-500)*.035}px,0) scale(1.02)`}ticking=false};
    addEventListener('scroll',()=>{if(!ticking){requestAnimationFrame(renderScroll);ticking=true}},{passive:true});renderScroll();
  </script>
</Layout>
